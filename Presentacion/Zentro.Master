<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Zentro.master.cs" Inherits="Presentacion.Zentro" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <link href="Content/estilosTarjetas.css" rel="stylesheet" />
    <link href="Content/estilosApp.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        form {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        footer {
            margin-top: auto; /* empuja el footer al fondo */
        }
    </style>

</head>
<body class="degradeFondo">
    <main>
    <form id="form1" runat="server">
        <div>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="container-fluid">
                    <a class="navbar-brand" href="#">Zentro</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav">
                            <%
                                if (usuario == null)
                                {%>
                            <li class="nav-item">
                                <a class="nav-link" href="Login.aspx">Login</a>
                            </li>
                            <%}%>
                            <li class="nav-item">
                                <a class="nav-link" href="Default.aspx">Home</a>
                            </li>
                            <%  if (usuario != null)
                                {%>
                            <li class="nav-item">
                                <a class="nav-link" href="Favoritos.aspx">Favoritos</a>
                            </li>

                            <%if (usuario != null && usuario.Admin)
                                {%>
                            <li class="nav-item">
                                <a class="nav-link" href="AdminProducto.aspx">Admin Productos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="AdminCategoria.aspx">Categorias</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="AdminMarca.aspx">Marcas</a>
                            </li>
                            <% }%>
                        </ul>
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="usuarioMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <asp:Image ID="imgUsuarioNav" runat="server" CssClass="rounded-circle" Width="32px" Height="32px" ImageUrl="Content/Imagenes/Imagen no disponible.png" />
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="usuarioMenu">
                                    <li>
                                        <span class="dropdown-item-text">
                                            <strong><%: usuario?.Nombre %> <%: usuario?.Apellido %></strong><br />
                                            <%: usuario?.Email %>
                                        </span>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>
                                    <li>
                                        <asp:LinkButton ID="btnModificarUsuario" runat="server" CssClass="dropdown-item" OnClick="btnModificarUsuario_Click">
                                                        Mi Perfil
                                        </asp:LinkButton>
                                    </li>
                                    <li>
                                        <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="dropdown-item" OnClick="btnCerrarSesion_Click">
                                                        Cerrar sesión
                                        </asp:LinkButton>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                        <% }%>
                    </div>
                </div>
            </nav>
        </div>
        <div class="container">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
        </main>
    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-2">© 2025 TPFinalNivel3CarlesJavier - Todos los derechos reservados</p>

            <!-- Links a redes -->
            <a href="https://www.linkedin.com/in/javier-carl%C3%A9s-555443226/" target="_blank"
                class="text-white me-2" aria-label="LinkedIn">
                <i class="bi bi-linkedin"></i>LinkedIn
            </a>
            <a href="https://github.com/JaviCarles" target="_blank"
                class="text-white me-2" aria-label="GitHub">
                <i class="bi bi-github"></i>GitHub
            </a>
            <a href="mailto:javiercarles1206@gmail.com"
                class="text-white me-2" aria-label="Email">
                <i class="bi bi-envelope"></i>Email
            </a>
        </div>
    </footer>

</body>
</html>
